# ====================================================================
# CivicSense Environment Configuration
# Copy this file to .env.local and fill in your own values.
# Never commit real keys: .env.local is git-ignored, this file is not.
# ====================================================================

# Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# SERVER ONLY - bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard -> Programmable Media -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SERVER ONLY - signs uploads and short-lived viewing URLs.
CLOUDINARY_API_SECRET=

# Gemini (https://aistudio.google.com/apikey) - complaint understanding (PRD "AI design").
# SERVER ONLY. Optional: without it, complaints are analysed by the built-in keyword rules.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: USD per million tokens, from Google's price list for GEMINI_MODEL. With both set,
# the console page "System" (/admin/system) shows an estimated cost next to the token counts.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=

# Optional: scheduled escalation/closure through GET /api/cron/escalations.
# Supply as Authorization: Bearer <CRON_SECRET> from your scheduler.
CRON_SECRET=
# Set true only in the long-running npm run server process to run maintenance every minute.
LOCAL_MAINTENANCE=false

# Agent tag (README -> "Agent tag"): students tag the bot in Telegram / Discord groups.
# Set CHAT_BOTS=true in exactly one running process. Tokens are SERVER ONLY.
CHAT_BOTS=false
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# Where students open the account-link link the bot sends them (default http://localhost:3000)
PUBLIC_SITE_URL=
# Moodle forums (moodle/local/civicsense/README.md). No CHAT_BOTS needed. SERVER ONLY.
# MOODLE_SECRET is the plugin's "Shared secret"; MOODLE_TOKEN is the bot account's web service token.
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_SECRET=
