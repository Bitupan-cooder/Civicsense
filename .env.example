# ====================================================================
# CivicSense Environment Configuration
# Copy this file to .env.local and fill in your own values.
# Never commit real keys: .env.local is git-ignored, this file is not.
# ====================================================================

# Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# SERVER ONLY - bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard -> Programmable Media -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SERVER ONLY - signs uploads and short-lived viewing URLs.
CLOUDINARY_API_SECRET=

# Gemini (https://aistudio.google.com/apikey) - complaint understanding (PRD "AI design").
# SERVER ONLY. Optional: without it, complaints are analysed by the built-in keyword rules.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=
