# CivicSense - Dibrugarh University Smart Campus Issue Management
# Environment Variables

# Google Gemini API Key for Multimodal AI and Multilingual Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (optional for local/demo mock mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App configuration
NEXT_PUBLIC_APP_NAME="CivicSense - Dibrugarh University"
NEXT_PUBLIC_DEFAULT_LOCALE=en
