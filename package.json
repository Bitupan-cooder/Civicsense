    "audit:slop": "node .agents/skills/hallmark/scripts/sloplint.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cloudinary": "^2.11.0",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
