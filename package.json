{
  "name": "civicsense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "server": "node --experimental-strip-types backend/server.ts",
    "test": "node --experimental-strip-types --test backend/access.test.ts backend/logic.test.ts backend/ai.test.ts",
    "test:live": "node backend/live-test.mjs",
